{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "lint": "prettier --check resources/js tests/e2e playwright.config.ts",
        "e2e": "playwright test",
        "e2e:serve": "test -f .env.e2e || (cp .env .env.e2e && echo AUTH_RATE_LIMIT=1000 >> .env.e2e); APP_ENV=e2e php artisan serve --port=8000"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@tailwindcss/vite": "^4.0.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "concurrently": "^10.0.3",
        "eslint": "^10.13.0",
        "jsdom": "^30.1.3",
        "laravel-vite-plugin": "^3.1",
        "msw": "^3.0.3",
        "prettier": "^3.9.10",
        "tailwindcss": "^4.0.0",
        "typescript": "^7.0.2",
        "vite": "^8.0.0",
        "vitest": "^5.0.5"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@fontsource-variable/schibsted-grotesk": "^5.3.0",
        "@tanstack/react-query": "^5.104.5",
        "axios": "^1.20.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.61.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router-dom": "^7.18.4",
        "shadcn": "^4.22.1",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0",
        "tw-animate-css": "^1.4.0",
        "zustand": "^5.0.16"
    }
}
